# Bound any client server a build or test starts (TIN-5770, R470). The default
# idle time is 3 h. A later rc (~/.bazelrc, user.bazelrc) or a command-line
# --max_idle_secs overrides this value.
startup --max_idle_secs=120

common --enable_bzlmod

build --jobs=auto
build --worker_sandboxing
build --disk_cache=~/.cache/bazel-tinyland-logging
build --show_timestamps
build --@aspect_rules_ts//ts:skipLibCheck=always

test --test_output=errors
test --test_timeout=120,600,1800,3600

build:ci --color=no
build:ci --curses=no
build:ci --noshow_loading_progress
test:ci --test_output=errors

# No remote cache or executor is configured, so a local run is local,
# non-qualifying (TIN-5770, R471). A remote profile attached later must never
# fall back to local execution.
build --remote_local_fallback=false

# Endpoint-free hook for a GloriousFlywheel lane fragment. The file does not
# exist until this repo enrolls. try-import skips a missing file.
try-import %workspace%/.bazelrc.flywheel

try-import %workspace%/user.bazelrc
